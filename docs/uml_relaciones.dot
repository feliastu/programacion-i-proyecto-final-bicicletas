digraph G { graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.35", ranksep="0.75", splines=polyline]; node [shape=plain, fontname="Liberation Sans", fontsize=13]; edge [fontname="Liberation Sans", fontsize=11, arrowsize=0.9];
OrdenServicio [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#E7EDF2"><B>OrdenServicio</B></TD></TR><TR><TD ALIGN="LEFT">- codigo: str<BR ALIGN="LEFT"/>- bicicleta: Bicicleta<BR ALIGN="LEFT"/>- servicios: list<BR ALIGN="LEFT"/>- estado: str<BR ALIGN="LEFT"/>- bitacora: Bitacora<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">- verificar_abierta()<BR ALIGN="LEFT"/>+ agregar_servicio(servicio)<BR ALIGN="LEFT"/>+ retirar_servicio(codigo): ServicioMantenimiento<BR ALIGN="LEFT"/>+ calcular_duracion_total(): int<BR ALIGN="LEFT"/>+ cerrar()<BR ALIGN="LEFT"/>+ consultar_movimientos(): tuple<BR ALIGN="LEFT"/>+ mostrar_bitacora(): str<BR ALIGN="LEFT"/>+ mostrar_informacion(): str<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Bicicleta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#E7EDF2"><B>Bicicleta</B></TD></TR><TR><TD ALIGN="LEFT">- codigo: str<BR ALIGN="LEFT"/>- marca: str<BR ALIGN="LEFT"/>- modelo: str<BR ALIGN="LEFT"/>- propietario: Cliente<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ mostrar_informacion(): str<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Cliente [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#E7EDF2"><B>Cliente</B></TD></TR><TR><TD ALIGN="LEFT">- codigo: str<BR ALIGN="LEFT"/>- nombre: str<BR ALIGN="LEFT"/>- telefono: str<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ actualizar_contacto(nombre, telefono)<BR ALIGN="LEFT"/>+ mostrar_informacion(): str<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Bitacora [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#E7EDF2"><B>Bitacora</B></TD></TR><TR><TD ALIGN="LEFT">- codigo_orden: str<BR ALIGN="LEFT"/>- movimientos: list<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ registrar(descripcion)<BR ALIGN="LEFT"/>+ consultar(): tuple<BR ALIGN="LEFT"/>+ mostrar_informacion(): str<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
ServicioMantenimiento [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#E7EDF2"><B>&lt;&lt;abstracta&gt;&gt;<BR/>ServicioMantenimiento</B></TD></TR><TR><TD ALIGN="LEFT">- codigo: str<BR ALIGN="LEFT"/>- observacion: str<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ mostrar_identificacion(): str<BR ALIGN="LEFT"/>+ describir_trabajo(): str {abstracto}<BR ALIGN="LEFT"/>+ calcular_duracion(): int {abstracto}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
OrdenServicio -> Bicicleta [taillabel="0..*", headlabel="1", labeldistance=2];
Bicicleta -> Cliente [taillabel="0..*", headlabel="1", labeldistance=2];
OrdenServicio -> ServicioMantenimiento [taillabel="0..*", headlabel="0..*", labeldistance=2];
OrdenServicio -> Bitacora [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="1", labeldistance=2];
}